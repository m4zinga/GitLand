{
  "manifest_version": 3,
  "name": "GitLand — Custom Backgrounds & Themes for GitHub",
  "version": "1.1.1",
  "description": "Give your GitHub profile and repos a custom background and colors. Share your theme with every visitor or keep it private.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "GitLand",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content/contentScript.js"],
      "css": ["content/contentStyles.css"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://github.com/*"
  ]
}
